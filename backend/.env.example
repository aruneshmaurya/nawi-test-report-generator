# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Database (Transaction Pooler Connection String)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Storage & API Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Authentication & Security
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=8h

# CORS & Public Client URLs
CORS_ORIGIN=https://your-frontend-app.vercel.app
PUBLIC_APP_URL=https://your-frontend-app.vercel.app

# Ephemeral File Upload Scratch Path
UPLOAD_DIR=/tmp/uploads
